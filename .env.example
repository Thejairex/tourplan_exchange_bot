# Copiar este archivo a ".env" (sin .example) y completar.
# El archivo .env NUNCA debe subirse a un repositorio Git.

# --- Tourplan ---
TOURPLAN_URL=https://tuinstancia.tourplan.net/
TOURPLAN_USER=usuario_bot
TOURPLAN_PASSWORD=cambiar_por_password_real

# true en producción (servidor sin pantalla). Poner "false" solo para
# probar en tu compu y ver el navegador moviéndose.
HEADLESS=false

# --- Validación de seguridad ---
# Si un valor nuevo difiere más de este % respecto del último cargado,
# se corta la corrida sin tocar Tourplan y se avisa por mail.
UMBRAL_VARIACION_PCT=15

# --- Alertas por email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=juarezjesusyair@gmail.com
SMTP_PASSWORD=olcnpgllgfesuhld
# ALERTA_EMAIL_TO=valentina.homez@eurotur.tur.ar
ALERTA_EMAIL_TO=mykasuitv@gmail.com
